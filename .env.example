# ── Bot kasyna (dla graczy) ───────────────────────────────────────────
DISCORD_TOKEN=
CLIENT_ID=

# ── Bot administracyjny (osobna aplikacja Discord) ────────────────────
ADMIN_BOT_TOKEN=
ADMIN_CLIENT_ID=
ADMIN_USER_ID=

# ── MariaDB (wspólna dla obu botów) ───────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ── Ustawienia rozgrywki ──────────────────────────────────────────────
DEFAULT_BET=100
BONUS_MULTIPLIER=5
BONUS_COOLDOWN_HOURS=12

# ── Top.gg: webhook (podstawowy sposób odbierania głosów) ─────────────
# Ten sam TOPGG_WEBHOOK_AUTH ustaw na top.gg: Edit Bot -> Webhooks
TOPGG_WEBHOOK_PORT=9911
TOPGG_WEBHOOK_AUTH=

# ── Top.gg: odpytywanie API (zapas, gdy webhook nie dochodzi) ──────────
# Legacy API Token utworzysz na top.gg: Edit Bot -> API -> Create Token
TOPGG_BOT_ID=
TOPGG_API_TOKEN=
